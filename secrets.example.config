<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to "secrets.config" (same folder) and fill in your own values.
  secrets.config is git-ignored, so the real AWS keys never reach GitHub.
  Web.config loads it with <appSettings file="secrets.config">; keys here override Web.config.
-->
<appSettings>
  <add key="AwsAccessKeyId" value="YOUR_ACCESS_KEY_ID" />
  <add key="AwsSecretAccessKey" value="YOUR_SECRET_ACCESS_KEY" />
  <add key="AwsS3BucketName" value="estoreja-products" />
  <add key="AwsS3Region" value="us-east-1" />
  <add key="AwsS3PublicBaseUrl" value="https://estoreja-products.s3.amazonaws.com" />
</appSettings>
