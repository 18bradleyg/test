# Copy this file to .env and fill in your own values. Never commit .env (it is git-ignored).
#
# Note: the web app itself reads its AWS settings from eStoreJA/secrets.config (also git-ignored),
# under these appSettings keys - keep the two files in step:
#   AWS_S3_ACCESS_KEY_ID      -> AwsAccessKeyId
#   AWS_S3_SECRET_ACCESS_KEY  -> AwsSecretAccessKey
#   AWS_S3_REGION             -> AwsS3Region        (e.g. us-east-1)
#   AWS_S3_BUCKET_NAME        -> AwsS3BucketName
#   (secrets.config also has AwsS3PublicBaseUrl, the bucket's public URL)

# S3 bucket (AWS) - product images
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET_NAME=
